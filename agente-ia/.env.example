# --- IA del agente: necesitas AL MENOS UNA de las dos claves de abajo ---
#
# Si solo tienes Gemini (es tu caso): deja ANTHROPIC_API_KEY vacía y solo
# llena GEMINI_API_KEY más abajo — el agente usa Gemini directamente como
# motor principal, sin necesitar Claude para nada.
#
# Si en algún momento consigues también una clave de Anthropic
# (console.anthropic.com -> API Keys), agrégala aquí: el agente pasa a usar
# Claude como principal y Gemini queda como respaldo automático si Claude falla.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta for Developers -> tu app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que tú inventas (cualquier texto) y pegas también en el webhook de Meta
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-texto-secreto

# Usuario y clave para entrar al panel CRM (autenticación básica simple)
CRM_USER=nicol
CRM_PASSWORD=cambia-esto

# Puerto del servidor (Railway/Render lo asignan solo, déjalo así)
PORT=3000

# Ruta del archivo de base de datos SQLite (en Railway, usa /data/alavision.db con un volumen montado)
DB_PATH=./data/alavision.db

# Clave de Gemini (Google AI Studio: aistudio.google.com/apikey, o tu cuenta
# de Gemini paga si ya la tienes con acceso a la API). Con esta sola, sin
# ANTHROPIC_API_KEY, el agente ya funciona completo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Envío de correos de confirmación de cita (resend.com — plan gratis alcanza para empezar)
RESEND_API_KEY=
RESEND_FROM=Óptica ALaVision <citas@tudominio.com>
