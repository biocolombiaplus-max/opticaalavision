# Clave de la API de Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta for Developers -> tu app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que tú inventas (cualquier texto) y pegas también en el webhook de Meta
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-texto-secreto

# Usuario y clave para entrar al panel CRM (autenticación básica simple)
CRM_USER=nicol
CRM_PASSWORD=cambia-esto

# Puerto del servidor (Railway/Render lo asignan solo, déjalo así)
PORT=3000

# Ruta del archivo de base de datos SQLite (en Railway, usa /data/alavision.db con un volumen montado)
DB_PATH=./data/alavision.db

# Respaldo de IA con Gemini (Google AI Studio: aistudio.google.com/apikey)
# Se usa automáticamente si la llamada a Claude falla.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Envío de correos de confirmación de cita (resend.com — plan gratis alcanza para empezar)
RESEND_API_KEY=
RESEND_FROM=Óptica ALaVision <citas@tudominio.com>
